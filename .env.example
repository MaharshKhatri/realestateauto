# Copy to .env (git-ignored). Everything is optional; the system runs with no keys.

# Database. Default: SQLite at ./wholesaling.db
# Free Postgres (Supabase/Neon) when you outgrow SQLite or want cloud agents to share state:
# WHOLESALING_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# If you run behind a TLS-intercepting proxy, point requests at its CA bundle:
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.crt
