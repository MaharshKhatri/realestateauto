@echo off
rem NJ Wholesale Dashboard launcher (generated by scripts\install_desktop_shortcut.py).
rem Starts the local cockpit if it isn't running, waits for it, and opens http://127.0.0.1:8000
setlocal
cd /d "%~dp0"
set "URL=http://127.0.0.1:8000"
set "PY=python"
if exist ".venv\Scripts\python.exe" set "PY=.venv\Scripts\python.exe"
if exist "venv\Scripts\python.exe" set "PY=venv\Scripts\python.exe"
if exist wholesaling.db goto dbready
if not exist data\snapshots\manifest.json goto dbready
echo First start on this computer: unlocking the database snapshot...
"%PY%" manage.py db-sync --unpack --if-missing
if errorlevel 1 (
  echo The database wasn't unlocked. Run: %PY% manage.py db-sync --unpack
  pause
  exit /b 1
)
:dbready
"%PY%" -c "import sys,urllib.request as u; sys.exit(0 if b'nj-wholesale-cockpit' in u.urlopen('http://127.0.0.1:8000/api/health',timeout=2).read() else 1)" >nul 2>&1 && goto ready
if not exist logs mkdir logs
echo Starting the dashboard (log: logs\server.log)...
start "NJ Wholesale Cockpit" /min cmd /c ""%PY%" manage.py server --port 8000 >> logs\server.log 2>&1"
for /L %%i in (1,1,60) do (
  "%PY%" -c "import sys,urllib.request as u; sys.exit(0 if b'nj-wholesale-cockpit' in u.urlopen('http://127.0.0.1:8000/api/health',timeout=2).read() else 1)" >nul 2>&1 && goto ready
  timeout /t 1 /nobreak >nul
)
echo The dashboard didn't start. See logs\server.log
pause
exit /b 1
:ready
echo Dashboard running at %URL%
if not defined NJW_NO_BROWSER start "" "%URL%"
