data/snapshots/
config/settings.local.yaml
# Google Calendar OAuth client + the operator's token (engine/gcal_sync.py)
config/credentials.json
config/token.json

# Run logs (swarm_intelligence.md is aggregate-only and IS committed)
logs/*.log

data/imports/
# JV partners' proof-of-funds letters and bank statements
data/partners/

# Generated deal documents (LOI/PSA/deal sheets name the seller) — never commit.
deals/

